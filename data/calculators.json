      "updatedAt": "2025-06-01T09:00:00.000Z",
      "formula": {
        "kind": "expression",
        "expression": "pi * r^2"
      }
    },
    {
      "id": "7d4f3e6c-5f7a-4b8c-8d9e-3f4a5b6c7d8e",
      "slug": "hypotenuse",
