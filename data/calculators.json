{
  "calculators": [
    {
      "id": "9b2f1c4a-3d5e-4f6a-8b7c-1d2e3f4a5b6c",
      "slug": "quadratic-root",
      "name": "Quadratic Root",
      "description": "Solves ax² + bx + c = 0 and returns the larger real root.",
      "subject": "math",
      "inputs": [
        {
          "label": "Coefficient a",
          "variable": "a",
          "defaultValue": 1
        },
        {
          "label": "Coefficient b",
          "variable": "b",
          "defaultValue": -3
        },
        {
          "label": "Coefficient c",
          "variable": "c",
          "defaultValue": 2
        }
      ],
      "outputUnit": "",
      "createdAt": "2025-06-01T09:00:00.000Z",
      "updatedAt": "2025-06-01T09:00:00.000Z",
      "formula": {
        "kind": "expression",
        "expression": "(-b + sqrt(b^2 - 4*a*c)) / (2*a)"
      }
    },
    {
      "id": "8c3e2d5b-4e6f-4a7b-9c8d-2e3f4a5b6c7d",
      "slug": "circle-area",
      "name": "Circle Area",
      "description": "Area of a circle from its radius.",
      "subject": "math",
      "inputs": [
        {
          "label": "Radius",
          "variable": "r",
          "defaultValue": 5
        }
      ],
      "outputUnit": "m²",
