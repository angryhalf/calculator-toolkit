      "updatedAt": "2025-06-01T09:00:00.000Z",
      "formula": {
        "kind": "expression",
        "expression": "0.5 * m * v^2"
      }
    },
    {
      "id": "5f6b5a8e-7b9c-4d0e-af1a-5b6c7d8e9f0a",
