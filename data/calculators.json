      "inputs": [
        {
          "label": "Height (m)",
          "variable": "h",
          "defaultValue": 20
        },
        {
          "label": "Gravity (m/s²)",
          "variable": "g",
          "defaultValue": 9.81
        }
      ],
      "outputUnit": "s",
