    },
    {
      "id": "4a7c6b9f-8c0d-4e1f-b02b-6c7d8e9f0a1b",
      "slug": "compound-interest",
      "name": "Compound Interest",
      "description": "Final value of an investment with compound interest.",
      "subject": "finance",
      "inputs": [
        {
          "label": "Principal",
          "variable": "P",
          "defaultValue": 1000
        },
        {
          "label": "Annual rate (%)",
          "variable": "r",
          "defaultValue": 5
        },
        {
          "label": "Compounds per year",
          "variable": "n",
          "defaultValue": 12
        },
        {
          "label": "Years",
          "variable": "t",
          "defaultValue": 10
        }
      ],
      "outputUnit": "",
      "createdAt": "2025-06-01T09:00:00.000Z",
      "updatedAt": "2025-06-01T09:00:00.000Z",
      "formula": {
        "kind": "expression",
        "expression": "P * (1 + r/(100*n))^(n*t)"
      }
    },
    {
